# Catkin build artifacts
build/
devel/
install/
logs/
.catkin_workspace

# Isaac Sim USD scene assets (~600 MB).
# Simulation support was removed from this workspace, so nothing here reads
# them any more. Kept on disk but out of git — the .usd/.stp files are large
# binaries and were never a sensible thing to version.
polishing_env/

# Local review / analysis output, not part of the deliverable
review_reports/

# Python
__pycache__/
*.pyc
*.pyo

# Large model files
*.onnx
*.pt
*.pth
*.pdf

# Runtime / backup output. Result CSVs are written to
# log/apriltag_nav/ra_maps/ (results/ra_maps/ before 2026-09-15, moved on
# user request — see results/README.md) and ARE versioned there (the
# deliverable, ~100 KB each); a stray copy next to the input path files in
# task/csv is not.
src/apriltag_nav/task/csv/*_result_*.csv
src/apriltag_nav/task/csv/*_ra_map_*.csv
# The bulk that goes with them is not versioned (gitignore has no trailing
# comments — keep each pattern on its own line):
#   results/scan_images/  wrist-camera frames, ~10 MB each (ra_maps/ holds the numbers)
#   results/captures/     robot_ui Collect-tab captures
#   log/ros/              roslaunch / node logs (ROS_LOG_DIR, set by the env hook)
results/scan_images/
results/captures/
log/ros/
*.bak

# External camera driver source trees are upstream repositories.
src/orbbec_camera/
src/realsense-ros/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude
.claude/

# GitHub personal access token used for pushing — never commit
token

# Robot run logs moved into the workspace 2026-09-09 (log/).
# The RECORDS are versioned — yaml (nav_log arrivals, calibration session /
# entry records, map_world), npz (hand-eye observations) and csv, ~6.5 MB.
# The bulk is not, and both exclusions are deliberate:
#   *.mp4 / *.webm  screen recordings, 230-388 MB each. GitHub hard-blocks
#                   any file over 100 MB, so these CANNOT be pushed without
#                   Git LFS + a paid data pack. Kept on disk / USB instead
#                   (user's decision 2026-09-09).
#   *.png           front_cam snapshots, 776 files / 471 MB. They would take
#                   the repo from 119 MB to ~600 MB permanently; the yaml
#                   record of each run is kept and carries the numbers.
log/**/*.mp4
log/**/*.webm
log/**/*.png
# …except the hand-eye samples: they are the INPUT the calibration is
# recomputed from (calibrate() re-detects over the archive), ~0.4 MB each,
# not re-checkable evidence like the front_cam snapshots above.
!log/path_tag_locator/handeye_calib/**/*.png
log/*.mp4
log/*.webm
log/**/*.tmp

# LibreOffice lock files
.~lock.*#

# robot_ui web check artifact (tools/check_web_ui_browser.py rewrites it every run)
src/robot_ui/tools/web_ui_screenshot.png
