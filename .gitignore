# Catkin build artifacts
build/
devel/
install/
.catkin_workspace

# Python
__pycache__/
*.pyc
*.pyo

# Large model files and rendered documents
*.onnx
*.pt
*.pth
*.pdf

# Run output under results/ (see results/README.md). The numbers are
# versioned — Ra maps in log/apriltag_nav/ra_maps/, the hand-measured
# <run>/<run>_ra_measured.csv / _mark_template.csv beside the frames — the
# bulk is not (gitignore has no trailing comments — one pattern per line):
#   results/scan_images/  wrist-camera frames, ~10 MB each
#   results/captures/     robot_ui Collect-tab captures
#   results/ra_dataset/   merge_ra_dataset.py output, regenerable
#   results/tip_check/    tip-tour Basler frames (records in log/apriltag_nav/tip_check)
#   log/ros/              roslaunch / node logs (ROS_LOG_DIR, set by the env hook)
results/scan_images/**/*.png
results/scan_images/**/*.jpg
results/scan_images/**/*.zip
results/captures/
results/ra_dataset/
results/tip_check/**/*.png
results/tip_check/**/*.jpg
log/ros/
*.bak

# External camera driver source trees are upstream repositories.
src/orbbec_camera/
src/realsense-ros/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude
.claude/

# GitHub personal access token used for pushing — never commit
token

# Records under log/ are versioned (yaml, npz, csv); the bulk is not:
#   *.mp4 / *.webm  screen recordings — GitHub blocks files over 100 MB
#   *.png           front_cam / locate snapshots — the yaml record of each run
#                   carries the numbers
log/**/*.mp4
log/**/*.webm
log/**/*.png
# …except the hand-eye samples: they are the INPUT calibrate() re-detects
# over, ~0.4 MB each.
!log/path_tag_locator/handeye_calib/**/*.png
log/**/*.tmp

# LibreOffice lock files
.~lock.*#

# robot_ui web check artifact (tools/check_web_ui_browser.py rewrites it every run)
src/robot_ui/tools/web_ui_screenshot.png

# The A0 calibration sheet is the RULER of chain_calib (2026-09-18) — the
# print file must travel with the layout JSON that describes it.
!src/chain_calib/sheet/*.pdf
