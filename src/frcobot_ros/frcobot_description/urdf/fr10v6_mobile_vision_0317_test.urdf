<?xml version="1.0" encoding="utf-8"?>
<robot name="fr10v6_mobile">

  <!-- Mobile Base Link -->
  <link name="mobile_base">
    <visual>
      <origin xyz="0 0 0.326" rpy="0 0 0" />
      <geometry>
        <box size="0.9 0.7 0.652" />
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.326" rpy="0 0 0" />
      <geometry>
        <box size="0.9 0.7 0.652" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.326" rpy="0 0 0" />
      <mass value="50.0" />
      <inertia ixx="3.812933" ixy="0" ixz="0" iyy="5.146267" iyz="0" izz="5.416667" />
    </inertial>
  </link>

  <!-- Joint connecting mobile base to manipulator base.
       CALIBRATED 2026-09-22 (chain_calib PLANAR fit: x, y, yaw only; roll = pitch = 0, z = design): = inv(tf_chain.yaml T_ab2mb)
       seen from this mobile_base frame, which is yawed 180 deg from the code's body frame
       (x forward, y left). Design was xyz="0 0.1 0.652" rpy="0 0 0". Must stay equal to
       tf_chain.yaml T_ab2mb (tf_chain_tool.py check / check_pose_vs_joint.py assert it). Paths planned with the
       design value land ~35 mm off at 1 m reach - regenerate rrt_final_path_* with this. -->
  <joint name="mobile_to_base" type="fixed">
    <parent link="mobile_base" />
    <child link="base_link" />
    <origin xyz="0.006706 0.106230 0.652000" rpy="0.000000000 0.000000000 0.014030243" />
  </joint>

