<?xml version="1.0"?>
<package format="2">
  <name>robot_ui</name>
  <version>1.0.0</version>
  <description>
    Operator UI for the mobile manipulator: data collection, manual arm
    teaching, task control. Integration only — it owns no device and opens no
    hardware. Every capability it exposes is reached over ROS from the node
    that owns the device (arm_node, basler_camera_node, lifter_node,
    mobile_node, inference_node, task_executor).
  </description>
  <maintainer email="user@example.com">User</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>robot_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>robot_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>

  <!-- Runtime peers. Not build deps: this package imports none of their code,
       it only calls their topics and services. Listed so a bringup that starts
       the UI pulls in the nodes it is useless without. -->
  <exec_depend>apriltag_nav</exec_depend>
  <!-- calibration bridge methods lazy-import its srvs -->
  <exec_depend>path_tag_locator</exec_depend>
</package>
