# EnvironmentFile of mobile-manipulator.service (KEY=VALUE, no quotes needed,
# no shell expansion). Edit, then `sudo systemctl restart mobile-manipulator`.
# Every key is optional; the defaults live in run_stack.sh.

# Extra roslaunch args, space separated, e.g.
#   LAUNCH_ARGS=use_hand_cam:=false use_web_ui:=false
LAUNCH_ARGS=

# Bounded waits before launching (seconds; 0 = do not wait for that device).
#WAIT_MASTER_S=120
#WAIT_ARM_S=180
#WAIT_KEYENCE_S=30
