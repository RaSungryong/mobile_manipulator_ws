<?xml version="1.0"?>
<package format="2">
  <name>apriltag_nav</name>
  <version>1.0.0</version>
  <description>AprilTag based navigation package with Pure Pursuit</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>robot_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>robot_msgs</exec_depend>
  <exec_depend>python-pandas</exec_depend>

  <!-- front_cam (Orbbec Femto Bolt) / side_cam (RealSense D405) drivers.
       robot_camera_node.py only subscribes to their sensor_msgs/Image and
       CameraInfo topics at runtime; it never imports their message types,
       so these are launch-time deps only, not build deps. -->
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
</package>
